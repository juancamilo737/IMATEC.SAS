# Variables de entorno para el despliegue en Railway.
# En Railway se cargan en:  proyecto -> servicio -> pestaña Variables

# Carpeta del disco persistente (Volume). DEBE coincidir con el "Mount path"
# del volumen que se cree en Railway. Sin esto se pierde TODO en cada despliegue.
IMATEC_DATA_DIR=/datos

# Clave con la que se firman las sesiones. Genere una larga y única:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
IMATEC_SECRET_KEY=

# Primer usuario administrador
IMATEC_ADMIN_EMAIL=admin@imatecsas.com
IMATEC_ADMIN_PASSWORD=

# Railway define RAILWAY_ENVIRONMENT y PORT automáticamente; no los toque.
